# Local skeleton defaults. This file is safe to commit.
# Do not put real credentials here. The backend rejects broker and LLM secrets.
# Spring Boot does not load this file automatically; export it only for local runs.

TRADING_ENVIRONMENT=DEMO
TRADING_OPERATIONAL_STATE=OBSERVATION
TRADING_BROKER_ENABLED=false
TRADING_BROKER_BASE_URL=

SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Used only by infra/docker-compose.yml. The backend does not read these.
POSTGRES_USER=trading
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=trading
POSTGRES_PORT=5432
